# 智刷星 · LLM 配置示例
# 复制本文件为同目录下的 .env，并填入你自己的 Key 即可启用「AI 深度分析」。
# 注意：.env 含密钥，请勿提交到代码仓库。

# ===== 必填：你的 API Key =====
LLM_API_KEY=sk-your-key-here

# ===== 必填：接口地址（OpenAI 兼容格式，下面任选其一，去掉前面的 #）=====
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DeepSeek（深度求索，便宜好用，推荐先用这个）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Moonshot / Kimi（月之暗面）
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# 智谱 GLM
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 通义千问 Qwen
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ===== 可选 =====
# 请求超时（秒）
LLM_TIMEOUT=90
# 服务端口（云主机部署时由平台注入 PORT，本机可改）
PORT=8123
# 监听地址：默认 0.0.0.0（本机/隧道/云主机均可访问）。仅本机使用时也可设 127.0.0.1。
BIND_HOST=0.0.0.0
# 访问口令（公网部署强烈建议设置）：设置后所有 /api/* 接口必须带此口令
# （前端会在首次使用时弹窗让你输入并记住），否则 403。可防止链接泄露被白嫖额度。
# SITE_TOKEN=设一个只有你自己知道的字符串

